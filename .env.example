
# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Config
VITE_FIREBASE_API_KEY="your-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_DATABASE_URL="https://your-project-id-default-rtdb.firebaseio.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"
VITE_FIREBASE_APP_ID="your-app-id"
VITE_FIREBASE_MEASUREMENT_ID="your-measurement-id"

# ─── SECURITY: Client-Side Encryption Key ────────────────────────────────────
# Wajib diset di production! Digunakan untuk enkripsi NIK dan foto biometrik
# sebelum dikirim ke Firebase (AES-GCM-256 via Web Crypto API).
# Generate key kuat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VITE_ENCRYPTION_SECRET="your-random-32-byte-hex-encryption-key"
VITE_GAS_EMAIL_URL=https://script.google.com/macros/s/AKfycbxFdrxQCGEIXs5KE7MxQEw03ly4e_LWRBF5kflgpG4CGhzAdtRHcxj45AbH6d8q87ej/exec
