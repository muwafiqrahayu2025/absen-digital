{
  "rules": {
    ".read": "auth != null",
    ".write": "false",
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.uid == $uid || root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'developer')",
        ".validate": "newData.hasChildren(['username', 'name', 'role'])",
        "username": {
          ".validate": "newData.isString() && newData.val().length < 50"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length < 100"
        },
        "role": {
          ".validate": "newData.isString() && (newData.val() == 'admin' || newData.val() == 'developer' || newData.val() == 'kepala_madrasah' || newData.val() == 'guru' || newData.val() == 'staf_sekolah')"
        },
        "$other": {
          ".validate": true
        }
      }
    },
    "attendance": {
      ".indexOn": ["userId", "date"],
      "$recordId": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('userId').val() == auth.uid || root.child('users').child(auth.uid).child('role').val() == 'admin')",
        ".validate": "newData.hasChildren(['userId', 'date', 'status', 'timestamp'])",
        "userId": {
          ".validate": "newData.isString() && newData.val() == auth.uid"
        },
        "status": {
          ".validate": "newData.isString() && (newData.val() == 'hadir' || newData.val() == 'izin' || newData.val() == 'sakit' || newData.val() == 'alpha')"
        },
        "date": {
          ".validate": "newData.isString() && newData.val().length == 10"
        },
        "timestamp": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": true
        }
      }
    },
    "cuti_requests": {
      ".indexOn": ["userId"],
      "$requestId": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['userId', 'status'])",
        "userId": {
           ".validate": "newData.isString()"
        },
        "status": {
           ".validate": "newData.isString() && (newData.val() == 'pending' || newData.val() == 'approved' || newData.val() == 'rejected')"
        },
        "$other": {
          ".validate": true
        }
      }
    },
    "school_config": {
      ".read": "true",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin'"
    }
  }
}
