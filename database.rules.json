{
  "rules": {

    // ════════════════════════════════════════════════════════════════════
    // CATATAN ARSITEKTUR:
    // - Developer (global_admins): akses penuh via root-level rule.
    // - Admin: R/W penuh dalam tenant.
    // - Kepala Sekolah: Read-only dalam tenant.
    // - Guru/Staf: Read-only master data, Write hanya data diri sendiri.
    //
    // PATH MASTER DATA YANG DIGUNAKAN (hasil audit lengkap src/):
    //   opds, satuanKerjas, satuankerja (inkonsistensi path di codebase),
    //   jabatans, kinerjas, kinerja_records, shift_schedules, schedules,
    //   academic_years, holidays, cuti_requests, school, users, attendance,
    //   deviceSessionLogs, notification_log, qr_sessions, license
    // ════════════════════════════════════════════════════════════════════

    // ── DEVELOPER: Akses Root Penuh ──────────────────────────────────
    ".read":  "auth != null && root.child('global_admins').child(auth.uid).val() == true",
    ".write": "auth != null && root.child('global_admins').child(auth.uid).val() == true",

    // ════════════════════════════════════════════════════════════════════
    // NODE GLOBAL
    // ════════════════════════════════════════════════════════════════════

    "global_admins": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid == $uid && !root.child('global_admins').exists()"
      }
    },

    "global_users": {
      "$uid": {
        ".read":  "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },

    "global_settings": {
      ".read":  "auth != null",
      ".write": "auth != null && root.child('global_admins').child(auth.uid).val() == true"
    },

    "user_tenant_mapping": {
      "$uid": {
        ".read":  "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },

    // ════════════════════════════════════════════════════════════════════
    // NODE TENANT — HELPER SHORTCUTS (digunakan berulang)
    //
    // isMember  = auth.uid terdaftar di tenant ini
    // isAdmin   = isMember && role == 'admin'
    // isKepsek  = isMember && role == 'kepala_sekolah'
    // isDev     = ada di global_admins
    // canManage = isAdmin || isDev
    // canView   = isMember (semua role dalam tenant bisa view)
    // canViewReport = isAdmin || isKepsek || isDev
    // ════════════════════════════════════════════════════════════════════
    "tenants": {

      "$tenantId": {

        // ── DATA SEKOLAH / PROFIL INSTITUSI ────────────────────────
        "school": {
          ".read":  "auth != null && root.child('user_tenant_mapping').child(auth.uid).val() == $tenantId",
          ".write": "auth != null && root.child('user_tenant_mapping').child(auth.uid).val() == $tenantId && root.child('tenants').child($tenantId).child('users').child(auth.uid).child('role').val() == 'admin'"
        },

        // ── MANAJEMEN PENGGUNA ──────────────────────────────────────
        "users": {
          ".read":  "auth != null && root.child('user_tenant_mapping').child(auth.uid).val() == $tenantId && (root.child('tenants').child($tenantId).child('users').child(auth.uid).child('role').val() == 'admin' || root.child('tenants').child($tenantId).child('users').child(auth.uid).child('role').val() == 'kepala_sekolah')",
          ".write": "auth != null && root.child('user_tenant_mapping').child(auth.uid).val() == $tenantId && root.child('tenants').child($tenantId).child('users').child(auth.uid).child('role').val() == 'admin'",
          ".indexOn": ["username", "role", "email"],
          "$uid": {
            ".read":  "auth != null && auth.uid == $uid",
            ".write": "auth != null && (auth.uid == $uid || (root.child('user_tenant_mapping').child(auth.uid).val() == $tenantId && root.child('tenants').child($tenantId).child('users').child(auth.uid).child('role').val() == 'admin'))"
          }
        },

        // ── DATA ABSENSI ────────────────────────────────────────────
        "attendance": {
          ".read":  "auth != null && root.child('user_tenant_mapping').child(auth.uid).val() == $tenantId && (root.child('tenants').child($tenantId).child('users').child(auth.uid).child('role').val() == 'admin' || root.child('tenants').child($tenantId).child('users').child(auth.uid).child('role').val() == 'kepala_sekolah')",
          ".write": "auth != null && root.child('user_tenant_mapping').child(auth.uid).val() == $tenantId && root.child('tenants').child($tenantId).child('users').child(auth.uid).child('role').val() == 'admin'",
          ".indexOn": ["userId", "date", "status"],
          "$attId": {
            ".read":  "auth != null && root.child('user_tenant_mapping').child(auth.uid).val() == $tenantId",
            ".write": "auth != null && root.child('user_tenant_mapping').child(auth.uid).val() == $tenantId && (newData.child('userId').val() == auth.uid || !newData.exists())"
          }
        },

        // ════════════════════════════════════════════════════════════
        // MASTER DATA — YAYASAN / DINAS / OPD
        // Path: tenants/$id/opds
        // Digunakan: Dashboard.tsx (tambah/list), ManageUsers.tsx (edit/hapus)
        // ════════════════════════════════════════════════════════════
        "opds": {
          // Semua anggota tenant bisa READ (guru butuh data ini untuk dropdown profil)
          ".read":  "auth != null && root.child('user_tenant_mapping').child(auth.uid).val() == $tenantId",
          // Hanya Admin yang bisa tambah/ubah/hapus (BYPASS untuk Akun Demo)
          ".write": "auth != null && (auth.token.email === 'admin@demo.com' || auth.token.email === 'alpha@demo.com' || (root.child('user_tenant_mapping').child(auth.uid).val() == $tenantId && root.child('tenants').child($tenantId).child('users').child(auth.uid).child('role').val() == 'admin'))",
          ".indexOn": ["singkatan", "nama"],
          "$opdId": {
            ".read":  "auth != null && root.child('user_tenant_mapping').child(auth.uid).val() == $tenantId",
            ".write": "auth != null && (auth.token.email === 'admin@demo.com' || auth.token.email === 'alpha@demo.com' || (root.child('user_tenant_mapping').child(auth.uid).val() == $tenantId && root.child('tenants').child($tenantId).child('users').child(auth.uid).child('role').val() == 'admin'))"
          }
        },

        // ════════════════════════════════════════════════════════════
        // MASTER DATA — SATUAN KERJA (path: satuanKerjas)
        // Path: tenants/$id/satuanKerjas  ← dipakai ManageUsers.tsx & Register.tsx
        // ════════════════════════════════════════════════════════════
        "satuanKerjas": {
          ".read":  "auth != null && root.child('user_tenant_mapping').child(auth.uid).val() == $tenantId",
          ".write": "auth != null && (auth.token.email === 'admin@demo.com' || auth.token.email === 'alpha@demo.com' || (root.child('user_tenant_mapping').child(auth.uid).val() == $tenantId && root.child('tenants').child($tenantId).child('users').child(auth.uid).child('role').val() == 'admin'))",
          ".indexOn": ["singkatan", "nama", "opdId"],
          "$satkerId": {
            ".read":  "auth != null && root.child('user_tenant_mapping').child(auth.uid).val() == $tenantId",
            ".write": "auth != null && (auth.token.email === 'admin@demo.com' || auth.token.email === 'alpha@demo.com' || (root.child('user_tenant_mapping').child(auth.uid).val() == $tenantId && root.child('tenants').child($tenantId).child('users').child(auth.uid).child('role').val() == 'admin'))"
          }
        },

        // ════════════════════════════════════════════════════════════
        // MASTER DATA — SATUAN KERJA (path alternatif: satuankerja)
        // Path: tenants/$id/satuankerja  ← dipakai Dashboard.tsx
        // CATATAN: Ada inkonsistensi huruf kapital di codebase (satuanKerjas vs satuankerja)
        // Keduanya perlu diberi rule agar tidak ada yang DENIED.
        // ════════════════════════════════════════════════════════════
        "satuankerja": {
          ".read":  "auth != null && root.child('user_tenant_mapping').child(auth.uid).val() == $tenantId",
          ".write": "auth != null && (auth.token.email === 'admin@demo.com' || auth.token.email === 'alpha@demo.com' || (root.child('user_tenant_mapping').child(auth.uid).val() == $tenantId && root.child('tenants').child($tenantId).child('users').child(auth.uid).child('role').val() == 'admin'))",
          "$satkerId": {
            ".read":  "auth != null && root.child('user_tenant_mapping').child(auth.uid).val() == $tenantId",
            ".write": "auth != null && (auth.token.email === 'admin@demo.com' || auth.token.email === 'alpha@demo.com' || (root.child('user_tenant_mapping').child(auth.uid).val() == $tenantId && root.child('tenants').child($tenantId).child('users').child(auth.uid).child('role').val() == 'admin'))"
          }
        },

        // ════════════════════════════════════════════════════════════
        // MASTER DATA — JABATAN
        // Path: tenants/$id/jabatans
        // Digunakan: ManageUsers.tsx (add/edit/hapus jabatan)
        // ════════════════════════════════════════════════════════════
        "jabatans": {
          ".read":  "auth != null && root.child('user_tenant_mapping').child(auth.uid).val() == $tenantId",
          ".write": "auth != null && root.child('user_tenant_mapping').child(auth.uid).val() == $tenantId && root.child('tenants').child($tenantId).child('users').child(auth.uid).child('role').val() == 'admin'",
          ".indexOn": ["nama"],
          "$jabatanId": {
            ".read":  "auth != null && root.child('user_tenant_mapping').child(auth.uid).val() == $tenantId",
            ".write": "auth != null && root.child('user_tenant_mapping').child(auth.uid).val() == $tenantId && root.child('tenants').child($tenantId).child('users').child(auth.uid).child('role').val() == 'admin'"
          }
        },

        // ════════════════════════════════════════════════════════════
        // PENGAJUAN CUTI / IZIN
        // Path: tenants/$id/cuti_requests
        // ════════════════════════════════════════════════════════════
        "cuti_requests": {
          ".read":  "auth != null && root.child('user_tenant_mapping').child(auth.uid).val() == $tenantId && (root.child('tenants').child($tenantId).child('users').child(auth.uid).child('role').val() == 'admin' || root.child('tenants').child($tenantId).child('users').child(auth.uid).child('role').val() == 'kepala_sekolah')",
          ".write": "auth != null && root.child('user_tenant_mapping').child(auth.uid).val() == $tenantId && root.child('tenants').child($tenantId).child('users').child(auth.uid).child('role').val() == 'admin'",
          ".indexOn": ["userId", "status"],
          "$reqId": {
            ".read":  "auth != null && root.child('user_tenant_mapping').child(auth.uid).val() == $tenantId",
            ".write": "auth != null && root.child('user_tenant_mapping').child(auth.uid).val() == $tenantId && (newData.child('userId').val() == auth.uid || !newData.exists())"
          }
        },

        // ════════════════════════════════════════════════════════════
        // CATATAN KINERJA
        // Path: tenants/$id/kinerjas  ← Dashboard.tsx
        // Path: tenants/$id/kinerja_records  ← ManageSchool.tsx (reset data)
        // ════════════════════════════════════════════════════════════
        "kinerjas": {
          ".read":  "auth != null && root.child('user_tenant_mapping').child(auth.uid).val() == $tenantId && (root.child('tenants').child($tenantId).child('users').child(auth.uid).child('role').val() == 'admin' || root.child('tenants').child($tenantId).child('users').child(auth.uid).child('role').val() == 'kepala_sekolah')",
          ".write": "auth != null && root.child('user_tenant_mapping').child(auth.uid).val() == $tenantId && root.child('tenants').child($tenantId).child('users').child(auth.uid).child('role').val() == 'admin'",
          ".indexOn": ["userId", "tanggal"],
          "$recId": {
            ".read":  "auth != null && root.child('user_tenant_mapping').child(auth.uid).val() == $tenantId",
            ".write": "auth != null && root.child('user_tenant_mapping').child(auth.uid).val() == $tenantId && (newData.child('userId').val() == auth.uid || root.child('tenants').child($tenantId).child('users').child(auth.uid).child('role').val() == 'admin')"
          }
        },

        "kinerja_records": {
          ".read":  "auth != null && root.child('user_tenant_mapping').child(auth.uid).val() == $tenantId && (root.child('tenants').child($tenantId).child('users').child(auth.uid).child('role').val() == 'admin' || root.child('tenants').child($tenantId).child('users').child(auth.uid).child('role').val() == 'kepala_sekolah')",
          ".write": "auth != null && root.child('user_tenant_mapping').child(auth.uid).val() == $tenantId && root.child('tenants').child($tenantId).child('users').child(auth.uid).child('role').val() == 'admin'",
          ".indexOn": ["userId", "tanggal"]
        },

        // ════════════════════════════════════════════════════════════
        // JADWAL PELAJARAN / KERJA
        // Path: tenants/$id/schedules
        // ════════════════════════════════════════════════════════════
        "schedules": {
          ".read":  "auth != null && root.child('user_tenant_mapping').child(auth.uid).val() == $tenantId",
          ".write": "auth != null && root.child('user_tenant_mapping').child(auth.uid).val() == $tenantId && root.child('tenants').child($tenantId).child('users').child(auth.uid).child('role').val() == 'admin'"
        },

        // ════════════════════════════════════════════════════════════
        // JADWAL SHIFT / INSTANSI
        // Path: tenants/$id/shift_schedules
        // Digunakan: ManageAcademic.tsx
        // ════════════════════════════════════════════════════════════
        "shift_schedules": {
          ".read":  "auth != null && root.child('user_tenant_mapping').child(auth.uid).val() == $tenantId",
          ".write": "auth != null && root.child('user_tenant_mapping').child(auth.uid).val() == $tenantId && root.child('tenants').child($tenantId).child('users').child(auth.uid).child('role').val() == 'admin'"
        },

        // ════════════════════════════════════════════════════════════
        // TAHUN AKADEMIK
        // Path: tenants/$id/academic_years
        // ════════════════════════════════════════════════════════════
        "academic_years": {
          ".read":  "auth != null && root.child('user_tenant_mapping').child(auth.uid).val() == $tenantId",
          ".write": "auth != null && root.child('user_tenant_mapping').child(auth.uid).val() == $tenantId && root.child('tenants').child($tenantId).child('users').child(auth.uid).child('role').val() == 'admin'"
        },

        // ════════════════════════════════════════════════════════════
        // HARI LIBUR
        // Path: tenants/$id/holidays
        // ════════════════════════════════════════════════════════════
        "holidays": {
          ".read":  "auth != null && root.child('user_tenant_mapping').child(auth.uid).val() == $tenantId",
          ".write": "auth != null && root.child('user_tenant_mapping').child(auth.uid).val() == $tenantId && root.child('tenants').child($tenantId).child('users').child(auth.uid).child('role').val() == 'admin'"
        },

        // ════════════════════════════════════════════════════════════
        // LOG SESI PERANGKAT
        // Path: tenants/$id/deviceSessionLogs
        // Digunakan: deviceDetection.ts (push log saat login/presensi)
        // ════════════════════════════════════════════════════════════
        "deviceSessionLogs": {
          ".read":  "auth != null && root.child('user_tenant_mapping').child(auth.uid).val() == $tenantId && root.child('tenants').child($tenantId).child('users').child(auth.uid).child('role').val() == 'admin'",
          // Semua user tenant bisa push log (untuk mencatat aktivitas login/presensi mereka)
          ".write": "auth != null && root.child('user_tenant_mapping').child(auth.uid).val() == $tenantId"
        },

        // ════════════════════════════════════════════════════════════
        // QR CODE / SESI SCANNER
        // Path: tenants/$id/qr_sessions
        // ════════════════════════════════════════════════════════════
        "qr_sessions": {
          ".read":  "auth != null && root.child('user_tenant_mapping').child(auth.uid).val() == $tenantId",
          ".write": "auth != null && root.child('user_tenant_mapping').child(auth.uid).val() == $tenantId && root.child('tenants').child($tenantId).child('users').child(auth.uid).child('role').val() == 'admin'"
        },

        // ════════════════════════════════════════════════════════════
        // LISENSI
        // Path: tenants/$id/license
        // Hanya Developer yang bisa tulis, semua tenant member bisa baca
        // ════════════════════════════════════════════════════════════
        "license": {
          ".read":  "auth != null && root.child('user_tenant_mapping').child(auth.uid).val() == $tenantId",
          ".write": "auth != null && root.child('global_admins').child(auth.uid).val() == true"
        },

        // ════════════════════════════════════════════════════════════
        // LOG NOTIFIKASI
        // Path: tenants/$id/notification_log
        // ════════════════════════════════════════════════════════════
        "notification_log": {
          ".read":  "auth != null && root.child('user_tenant_mapping').child(auth.uid).val() == $tenantId && root.child('tenants').child($tenantId).child('users').child(auth.uid).child('role').val() == 'admin'",
          ".write": "auth != null && root.child('user_tenant_mapping').child(auth.uid).val() == $tenantId"
        }

      }
    }
  }
}
